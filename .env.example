# Copy to `.env` for local development (never commit `.env`).
# Production: set the same keys in Coolify (or your host) for the Node service.

# --- Database (PostgreSQL required) ---
# Local example: postgresql://postgres:postgres@localhost:5432/favoritos_lemoon?schema=public
DATABASE_URL=

# --- Shopify app (Partner Dashboard → App setup) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Must match shopify.app.toml access_scopes (comma-separated for shopify.server.ts)
SCOPES=read_customers,write_customers,customer_read_customers,customer_write_customers

# Public HTTPS origin of THIS app (no trailing slash). Must match shopify.app.toml application_url and Coolify domain.
SHOPIFY_APP_URL=https://favorites-shopify.lemoon.dev

# Optional: custom shop domain if your template needs it (see shopify.server.ts)
# SHOP_CUSTOM_DOMAIN=

# --- Native app (DLK) — POST /api/favorites ---
# Customer Account API shop numeric id (from shopify.com/{id}/account/...)
CUSTOMER_ACCOUNT_SHOP_ID=81260708052
CUSTOMER_ACCOUNT_API_VERSION=2026-01
# Comma-separated client ids (cid claim) allowed to call /api/favorites
CUSTOMER_ACCOUNT_ALLOWED_CLIENT_IDS=c5a43d43-e85e-4947-b2bc-d2931b387d03
CUSTOMER_ACCOUNT_TOKEN_ISSUER=https://shopify.com/authentication/81260708052
# myshopify.com domain for Admin API offline session (Favoritos - Lemoon installed here)
FAVORITES_SHOP_DOMAIN=dlk-fitness-moda.myshopify.com
